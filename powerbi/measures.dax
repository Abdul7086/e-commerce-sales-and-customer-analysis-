Sales = SUM(FactOrderLine[Sales])
Profit = SUM(FactOrderLine[Profit])
Quantity = SUM(FactOrderLine[Quantity])
Orders = DISTINCTCOUNT(FactOrderLine[Order ID])
Customers = DISTINCTCOUNT(DimCustomer[Customer ID])
Profit Margin = DIVIDE([Profit], [Sales])
Average Order Value = DIVIDE([Sales], [Orders])
Sales YoY % =
VAR PriorYearSales = CALCULATE([Sales], SAMEPERIODLASTYEAR(DimDate[Date]))
RETURN DIVIDE([Sales] - PriorYearSales, PriorYearSales)
Profit YoY % =
VAR PriorYearProfit = CALCULATE([Profit], SAMEPERIODLASTYEAR(DimDate[Date]))
RETURN DIVIDE([Profit] - PriorYearProfit, ABS(PriorYearProfit))
Average Discount = AVERAGE(FactOrderLine[Discount])
Loss Making Lines = CALCULATE(COUNTROWS(FactOrderLine), FactOrderLine[Profit] < 0)
Loss Line % = DIVIDE([Loss Making Lines], COUNTROWS(FactOrderLine))
Sales per Customer = DIVIDE([Sales], [Customers])
