{
  "name": "Superstore Sales and Customer Analysis",
  "reference": "https://github.com/avishek-choudhary/E-Commerce-Store-Analysis-/blob/main/E-commerce%20Sales%20Dashboard.pbix",
  "canvas": { "width": 1280, "height": 720, "background": "dark navy / teal gradient", "page_count": 1 },
  "visuals": [
    { "type": "title", "title": "Superstore Sales Dashboard", "x": 10, "y": 14, "width": 405, "height": 101 },
    { "type": "columnChart", "title": "Profit by Month", "x": 687, "y": 435, "width": 579, "height": 276, "axis": "DimDate[Month]", "values": ["[Profit]"] },
    { "type": "columnChart", "title": "Profit by Sub-Category", "x": 687, "y": 115, "width": 219, "height": 305, "axis": "DimProduct[Sub-Category]", "values": ["[Profit]"] },
    { "type": "donutChart", "title": "Quantity by Category", "x": 344, "y": 494, "width": 332, "height": 216, "legend": "DimProduct[Category]", "values": ["[Quantity]"], "tooltips": ["[Profit]"] },
    { "type": "donutChart", "title": "Quantity by Ship Mode", "x": 347, "y": 266, "width": 329, "height": 216, "legend": "DimShipMode[Ship Mode]", "values": ["[Quantity]"], "tooltips": ["[Profit]"] },
    { "type": "card", "title": "Sales", "x": 10, "y": 128, "width": 158, "height": 125, "measure": "[Sales]" },
    { "type": "card", "title": "Profit", "x": 178, "y": 128, "width": 158, "height": 125, "measure": "[Profit]" },
    { "type": "card", "title": "Quantity", "x": 347, "y": 128, "width": 158, "height": 125, "measure": "[Quantity]" },
    { "type": "card", "title": "Average Order Value", "x": 516, "y": 128, "width": 160, "height": 125, "measure": "[Average Order Value]" },
    { "type": "barChart", "title": "Sales by State", "x": 10, "y": 266, "width": 325, "height": 216, "axis": "DimGeography[State]", "values": ["[Sales]"], "tooltips": ["[Profit]"] },
    { "type": "columnChart", "title": "Top 10 Customers by Sales", "x": 10, "y": 494, "width": 325, "height": 216, "axis": "DimCustomer[Customer Name]", "values": ["[Sales]"], "filter": "Top 10 by [Sales]", "tooltips": ["[Profit]"] },
    { "type": "slicer", "title": "Order Quarter", "x": 423, "y": 14, "width": 253, "height": 101, "field": "DimDate[Quarter]" },
    { "type": "slicer", "title": "State", "x": 687, "y": 14, "width": 217, "height": 89, "field": "DimGeography[State]" },
    { "type": "map", "title": "Sales by City", "x": 919, "y": 14, "width": 348, "height": 406, "location": "DimGeography[City]", "size": "[Orders]", "tooltips": ["[Quantity]", "[Profit]"] }
  ],
  "adaptations": [
    "The reference's Amount field maps to Superstore Sales.",
    "The reference's Payment Mode field is unavailable; Ship Mode is used as a comparable order split.",
    "AOV is calculated as Sales / distinct Order ID instead of importing a row-level AOV field.",
    "Use the four year quarters and state slicer on the supplied order dates and geography."
  ]
}
